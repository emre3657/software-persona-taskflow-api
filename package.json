{
  "name": "taskflow-sqlserver-api",
  "version": "1.0.0",
  "description": "A task and project management REST API built with Express, TypeScript, and SQL Server.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/infrastructure/database/migrate.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emre3657/taskflow-sqlserver-api.git"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "rest-api",
    "sql-server",
    "clean-architecture"
  ],
  "author": "Emre Ekinci",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/emre3657/taskflow-sqlserver-api/issues"
  },
  "homepage": "https://github.com/emre3657/taskflow-sqlserver-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
